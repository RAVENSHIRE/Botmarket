# BOTMARKET environment configuration
# Copy to `.env` and adjust as needed.

APP_NAME=BOTMARKET
ENVIRONMENT=development
DEBUG=true

# Database — SQLite by default (zero setup). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg://botmarket:botmarket@db:5432/botmarket
DATABASE_URL=sqlite:///./botmarket.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend -> backend base URL (used by Next.js).
NEXT_PUBLIC_API_URL=http://localhost:8000

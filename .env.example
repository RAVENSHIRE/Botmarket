# BOTMARKET environment configuration
# Copy to `.env` and adjust as needed.

APP_NAME=BOTMARKET
ENVIRONMENT=development
DEBUG=true

# Database — SQLite by default (zero setup). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg://botmarket:botmarket@database:5432/botmarket
DATABASE_URL=sqlite:///./botmarket.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend -> backend base URL (used by Next.js).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Economy ---------------------------------------------------------------
# Every constant below re-tunes the simulation without touching code.

# Credits granted to a newly registered agent.
STARTING_WALLET=1000

# Fraction of a $BOT trade burned as a fee.
TRADE_FEE_RATE=0.003

# Memecoins: launch cost, and the linear bonding curve price(s) = base + slope*s.
COIN_LAUNCH_FEE=100
COIN_BASE_PRICE=1.0
COIN_SLOPE=0.01
# Reserve at which a coin graduates and stops minting new supply.
COIN_GRADUATION_RESERVE=5000

# Governance: cost to submit, ticks a proposal stays open, and the minimum
# total vote weight required for one to pass.
PROPOSAL_COST=250
PROPOSAL_VOTING_TICKS=3
PROPOSAL_QUORUM=1.0

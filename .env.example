# BOTMARKET environment configuration
# Copy to `.env` and adjust as needed.

APP_NAME=BOTMARKET
ENVIRONMENT=development
DEBUG=true

# Database — SQLite by default (zero setup). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg://botmarket:botmarket@database:5432/botmarket
DATABASE_URL=sqlite:///./botmarket.db

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend -> backend base URL (used by Next.js).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Economy ---------------------------------------------------------------
# Every constant below re-tunes the simulation without touching code.

# Credits granted to a newly registered agent.
STARTING_WALLET=1000

# Fraction of a $BOT trade burned as a fee.
TRADE_FEE_RATE=0.003

# Memecoins: launch cost, and the linear bonding curve price(s) = base + slope*s.
COIN_LAUNCH_FEE=100
COIN_BASE_PRICE=1.0
COIN_SLOPE=0.01
# Reserve at which a coin graduates and stops minting new supply.
COIN_GRADUATION_RESERVE=5000

# Governance: cost to submit, ticks a proposal stays open, and the minimum
# total vote weight required for one to pass.
PROPOSAL_COST=250
PROPOSAL_VOTING_TICKS=3
PROPOSAL_QUORUM=1.0

# --- Live trading ----------------------------------------------------------
# Botmarket ships paper-only. Everything below is what it takes to go live,
# and the defaults are the safe ones.

# Encrypts venue API secrets and wallet keys at rest. Generate with
# `botmarket keygen`. Without it no credential can be stored, so only the
# paper venue works. Losing it means re-linking every live account.
VENUE_ENCRYPTION_KEY=

# Global kill switch. Set false to refuse every order, including closes.
TRADING_ENABLED=true

# Real-money trading. Leave false unless you mean it — and note that even with
# this on, each mainnet order must also carry confirm_real_money.
ALLOW_MAINNET=false

# Pre-trade risk envelope. Every order is checked against these before it is
# sent, and refusals are recorded with the rule that stopped them.
MAX_LEVERAGE=5
MIN_ORDER_VALUE=10
MAX_ORDER_VALUE=1000
MAX_POSITION_VALUE=5000
MAX_GROSS_NOTIONAL=25000
# Realised loss for the day past which only position-reducing orders pass.
MAX_DAILY_LOSS=500

# Starting cash for a new paper account.
PAPER_STARTING_BALANCE=10000
